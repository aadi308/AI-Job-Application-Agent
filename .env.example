# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# "local" preserves the full private workflow. Hosted public deployments use "demo".
APP_MODE=local
DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch

# Dashboard-to-API address. The localhost default is used when omitted.
FASTAPI_URL=http://127.0.0.1:8000

# Required only for local LLM workflows — never add paid keys to a public demo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Optional — if unset, the app runs OpenRouter-only (its pre-Groq behavior).
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ROUTINE_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

LLM_PRIMARY_PROVIDER=groq
LLM_ENABLE_FALLBACK=true
LLM_ROUTINE_CONFIDENCE_THRESHOLD=0.85
LLM_MAX_RETRIES=3
