# Copy to .env and fill in real values. .env is gitignored — never commit real keys.

# "local" is the private single-user workflow, "demo" is anonymous/read-only, and
# "production" enables authenticated per-user workspaces through the API.
APP_MODE=local
DATABASE_URL=postgresql://jobsearch:jobsearch@localhost:5432/jobsearch
# Used only by the trusted scheduled importer; configure as a GitHub Actions secret.
DEMO_DATABASE_URL=
# Opt-in fictional fixtures for screenshots/tests. Keep false for the public live feed.
SEED_DEMO_DATA=false

# Dashboard-to-API address. The localhost default is used when omitted.
FASTAPI_URL=http://127.0.0.1:8000

# Required for APP_MODE=production. The anon key is designed for browser clients;
# never use or expose the Supabase service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Per-user daily cost controls for production model calls.
ATS_DAILY_LIMIT=3
RESUME_DAILY_LIMIT=2
GLOBAL_ATS_DAILY_LIMIT=30
GLOBAL_RESUME_DAILY_LIMIT=20

# At least one provider key is required for local LLM workflows. Groq can run alone;
# OpenRouter is optional unless selected as primary. Never add paid keys to a public demo.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODEL=openai/gpt-4o-mini

# Optional when OpenRouter is configured; sufficient by itself when Groq is primary.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_ROUTINE_MODEL=openai/gpt-oss-20b
GROQ_STRONG_MODEL=openai/gpt-oss-120b

LLM_PRIMARY_PROVIDER=groq
# Uses OpenRouter after Groq failures only when OPENROUTER_API_KEY is also present.
LLM_ENABLE_FALLBACK=true
LLM_ROUTINE_CONFIDENCE_THRESHOLD=0.85
LLM_MAX_RETRIES=3
